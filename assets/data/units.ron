// Unit and weapon definitions for all 21 roster entries.
//
// Numbers are converted from the OpenSA re-implementation (commit b61363d9, mods/sa/rules + weapons):
//   speed  = OpenRA units/tick / 1024 * 25        -> cells per second
//   reload = ticks / 25                            -> seconds
//   range/spread/inaccuracy = OpenRA WDist / 1024  -> cells
//   build_time = BuildDuration / 25                -> seconds
// They are OpenSA's reconstruction, NOT verified original Swarm Assault statistics
// (docs/GAMEPLAY_RESEARCH.md, assumption A1). Edit freely.
(
    weapons: {
        // ---------------------------------------------------------------- ants
        "ant_bite": (
            name: "Bite", range: 1.5, reload: 0.32, damage: 300.0, spread: 0.0,
            projectile: Instant, targets: (ground: true, air: false, colony: false),
            fire_delay: 0.15, effect: "bite", fire_sound: "ant_crunch",
            source: "opensa ants_light: Range 1c512, ReloadDelay 8, Damage 300, InvalidTargets Colony",
        ),
        "ant_grenade": (
            name: "Grenade", range: 6.0, reload: 1.6, damage: 1470.0, spread: 0.25,
