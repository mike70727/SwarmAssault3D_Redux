// Unit and weapon definitions: the 21-entry roster, the neutral creep plants and seeds.
//
// Numbers are converted from the OpenSA re-implementation (commit b61363d9, mods/sa/rules + weapons):
//   speed  = OpenRA units/tick / 1024 * 25        -> cells per second
//   reload = ticks / 25                            -> seconds
//   range/spread/inaccuracy = OpenRA WDist / 1024  -> cells
//   build_time = BuildDuration / 25                -> seconds
// They are OpenSA's reconstruction, NOT verified original Swarm Assault statistics
// (docs/GAMEPLAY_RESEARCH.md, assumption A1). Edit freely.
// Since 2026-10-14 health, damage, range, speed, breeding time, attack rate and sensor radius are the
// original program's own (the "ORIGINAL" notes in each `source`):
//   reload        = seconds from the start of one attack to the next: the original's attack animation
//                   (Game.ANI frame times) plus the fixed part of its wait after it
//   reload_jitter = the random part of that wait (rand() % A ms -> A / 1000)
//   scan_range    = the original's sensor radius (FUN_00421bf0)
(
    weapons: {
        // ---------------------------------------------------------------- ants
        "ant_bite": (
            name: "Bite", range: 1.0, reload: 0.3, damage: 4.0, spread: 0.0,
            projectile: Instant, targets: (ground: true, air: false, colony: true),
            fire_delay: 0.15, effect: "bite", fire_sound: "ant_crunch",
            source: "opensa ants_light: Range 1c512, ReloadDelay 8, Damage 300, InvalidTargets Colony; ORIGINAL VALUES: original: Ant Soldier FUN_00402e90 bites with message 0x82 value 4, attack range 1; ORIGINAL RATE (2026-10-14): the bite animation loops, 150+150 ms, Damage on frame 2",
        ),
        "ant_grenade": (
            name: "Grenade", range: 6.0, reload: 1.0, reload_jitter: 0.4, damage: 30.0, spread: 0.25,
            falloff: [100.0, 50.0, 25.0, 0.0], inaccuracy: 0.79,
            projectile: Bullet(speed: 6.35, arc: 0.35), targets: (ground: true, air: true, colony: true),
            fire_delay: 0.4, effect: "explosion_medium", impact_sound: "explosion1",
            source: "opensa ants_medium: Range 6c0, ReloadDelay 40, Damage 1470, Spread 256, Inaccuracy 813, Bullet speed 260; ORIGINAL VALUES: original: WeaponGrenade FUN_00433190 damage 30; Ant Grenadier FUN_00402230 range 6; ORIGINAL RATE (2026-10-14): attack animation 400+400 ms, then 200-599 ms (rand%400+200)",
        ),
        "ant_rocket": (
            name: "Rocket", range: 9.0, reload: 1.1, reload_jitter: 1.0, damage: 40.0, spread: 0.25, inaccuracy: 0.1,
            projectile: Bullet(speed: 8.54, arc: 0.02), targets: (ground: true, air: true, colony: true),
            fire_delay: 0.36, effect: "explosion_big", fire_sound: "rocket_launch", impact_sound: "explosion3",
            trail: "smoke",
            source: "opensa ants_heavy: Range 9c0, ReloadDelay 55, Damage 1950, Spread 256, Bullet speed 350; ORIGINAL VALUES: original: WeaponRocket FUN_00433ee0 damage 40; Ant Bazooka FUN_004015e0 range 9; ORIGINAL RATE (2026-10-14): attack animation 200+400 ms, then 500-1499 ms (rand%1000+500)",
        ),
        // ------------------------------------------------------------- beetles
        "beetle_mg": (
            name: "Heavy machine gun", range: 6.0, reload: 0.2, damage: 8.0, spread: 0.12, inaccuracy: 0.29,
            projectile: Instant, targets: (ground: true, air: true, colony: true),
            fire_delay: 0.05, effect: "hit_small", fire_sound: "minigun", impact_sound: "ricochet",
            source: "opensa beetles_light: Range 6c0, ReloadDelay 6, Damage 782, Spread 125, Inaccuracy 0c300; ORIGINAL VALUES: original: WeaponMiniGun FUN_004335c0 damage 8; Lady Bug FUN_004046a0 range 6; ORIGINAL RATE (2026-10-14): the attack animation loops, 100+100 ms, Fire Point on frame 2",
        ),
        "beetle_shrapnel": (
            name: "Shrapnel", range: 4.0, reload: 0.3, reload_jitter: 0.5, damage: 15.0, spread: 0.25,
            falloff: [100.0, 50.0, 25.0, 0.0], inaccuracy: 4.88, volley: 8, volley_spread_deg: 360.0,
            projectile: Bullet(speed: 4.8, arc: 0.45), targets: (ground: true, air: true, colony: true),
            fire_delay: 0.2, effect: "explosion_shrapnel", fire_sound: "shrapnel_fire", impact_sound: "explosion1",
            source: "opensa beetles_medium: 10 armaments, Range 3c0, ReloadDelay 25, Damage 850, Spread 256, Inaccuracy 5000; ORIGINAL VALUES: original: WeaponShrapnel FUN_00433960 damage 15 a fragment; Shrapnel Beetle FUN_00405260 throws 8, range 4; ORIGINAL RATE (2026-10-14): attack animation 100+100 ms, then 100-599 ms (rand%500+100); 8 fragments flung all round, no team test",
        ),
        "beetle_cannon": (
            name: "Cannon", range: 14.0, min_range: 2.0, reload: 0.8, reload_jitter: 0.7, damage: 40.0, spread: 0.29, inaccuracy: 1.46,
            projectile: Bullet(speed: 13.7, arc: 0.12), targets: (ground: true, air: true, colony: true),
            fire_delay: 0.2, effect: "explosion_big", fire_sound: "cannon", impact_sound: "explosion2",
            source: "opensa beetles_heavy: Range 14c0, ReloadDelay 30, Damage 1950, Spread 300, Inaccuracy 1500, Bullet speed 562; ORIGINAL VALUES: original: WeaponCannon FUN_004332f0 damage 40; Cannon Beetle FUN_004039e0 range 14; ORIGINAL RATE (2026-10-14): attack animation 100+300 ms, then 400-1099 ms (rand%700+400)",
