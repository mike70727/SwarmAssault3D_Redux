// Key bindings. Key names are Bevy `KeyCode` variant names (KeyW, ArrowUp, Digit1, F12, ...).
// Mouse: left click/drag = select, right click = move / attack, wheel = zoom, middle drag = pan.
(
    keys: {
        "pan_up": ["KeyW", "ArrowUp"],
        "pan_down": ["KeyS", "ArrowDown"],
        "pan_left": ["KeyA", "ArrowLeft"],
        "pan_right": ["KeyD", "ArrowRight"],
        "rotate_left": ["KeyQ"],
        "rotate_right": ["KeyE"],
        "zoom_in": ["Equal", "NumpadAdd"],
        "zoom_out": ["Minus", "NumpadSubtract"],
        "select_all": ["KeyC"],
        "add_to_selection": ["ShiftLeft", "ShiftRight"],
        "attack_move": ["KeyT"],
        "stop": ["KeyX"],
        "pause": ["Space"],
        "speed_up": ["BracketRight"],
        "speed_down": ["BracketLeft"],
        "breed_1": ["Digit1"],
        "breed_2": ["Digit2"],
        "breed_3": ["Digit3"],
        "breed_stop": ["Digit0"],
        "set_rally": ["KeyR"],
        "screenshot": ["F12"],
        "debug_nav": ["F3"],
        "quick_save": ["F5"],
        "quick_load": ["F9"],
        "menu": ["Escape"],
        "center_camera": ["Home"],
        "help": ["F1"],
        "console": ["Enter", "NumpadEnter"],
    },
    edge_pan: true,
    edge_pan_margin: 12.0,
    pan_speed: 28.0,
    zoom_speed: 1.0,
    rotate_speed: 1.6,
    invert_zoom: false,
    drag_threshold: 6.0,
)
