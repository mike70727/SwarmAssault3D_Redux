// Display / performance settings (read at start-up; the Settings dialog writes this file).
(
    width: 1280,
    height: 720,
    fullscreen: false,
    vsync: true,
    msaa: 4,            // 1, 2, 4 or 8 samples
    shadows: true,
    shadow_cascades: 3,
    shadow_distance: 120.0,
    master_volume: 0.8,
    sound_enabled: true,
    // simulation ticks per second override (0 = use rules.ron)
    tick_hz: 0.0,
    // campaign levels unlock one after another (saves/progress.ron); true makes all selectable
    unlock_all_levels: false,
)
